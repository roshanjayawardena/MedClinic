<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MedClinic.Migrations.PostgreSQL</RootNamespace>
    <!-- CA1861: EF Core migration files are auto-generated; inline arrays are intentional -->
    <NoWarn>CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <!--
    Add a ProjectReference for each module as it's built.
    This project exists solely to hold migrations — it references module runtime projects
    so EF can build the model at design time (dotnet ef migrations add).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Clinics\Clinics\Clinics.csproj" />
    <ProjectReference Include="..\..\Modules\Patients\Patients\Patients.csproj" />
    <ProjectReference Include="..\..\Modules\Appointments\Appointments\Appointments.csproj" />
    <ProjectReference Include="..\..\Modules\Encounters\Encounters\Encounters.csproj" />
    <ProjectReference Include="..\..\Modules\Prescriptions\Prescriptions\Prescriptions.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Identity\Identity.csproj" />
    <ProjectReference Include="..\..\Modules\Billing\Billing\Billing.csproj" />
    <ProjectReference Include="..\..\Modules\Notifications\Notifications\Notifications.csproj" />
  </ItemGroup>

</Project>
