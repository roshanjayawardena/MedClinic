<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- CA1707: xUnit test method naming convention uses underscores (Method_Should_Do) -->
    <!-- CA1310: string comparisons in test helpers don't need explicit culture -->
    <NoWarn>CA1707;CA1310</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Reference every module runtime project so their assemblies land in the AppDomain.
    The architecture tests enforce cross-module boundary rules using NetArchTest.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Patients\Patients\Patients.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Appointments\Appointments\Appointments.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Encounters\Encounters\Encounters.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Prescriptions\Prescriptions\Prescriptions.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Identity\Identity\Identity.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Billing\Billing\Billing.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Notifications\Notifications\Notifications.csproj" />
  </ItemGroup>

</Project>
